# Copy to .env and fill in. Every value is read inside a request handler,
# never at build time. See docs/DEPLOYMENT.md for where to get each one.

# --- Chat model (Cerebras, gemma-4-31b) ---
# Intent extraction, grounded explanations, JD parsing, the mentor/coach, and
# the verification interview. Optional: explanations fall back to deterministic
# text without it, but the JD gap analyzer and the interview are unavailable.
CEREBRAS_API_KEY=

# --- Embeddings (Gemini) ---
# Semantic search only. Cerebras serves no embedding model, so this stays on
# gemini-embedding-001; without it `/api/search` cannot embed a query.
GEMINI_API_KEY=

# --- Data stores ---
MONGODB_URI=
NEO4J_URI=
NEO4J_USER=
NEO4J_PASSWORD=
QDRANT_URL=
QDRANT_API_KEY=

# Optional store tuning.
# MONGODB_DB defaults to "skillforge". MONGODB_MAX_POOL_SIZE defaults to 10 —
# lower it if many serverless instances share an Atlas free-tier limit.
# DNS_SERVERS is only used to resolve a mongodb+srv:// URI when the platform
# resolver cannot (see lib/db/mongo.ts).
MONGODB_DB=
MONGODB_MAX_POOL_SIZE=
DNS_SERVERS=

# --- Evidence signing ---
# HMAC key for the signature on every evidence record, checked by /verify/<id>.
# Optional: a well-known dev key is used when unset (signatures still verify
# within one deployment, they are just not unforgeable). Set a real random value
# anywhere a shared evidence link needs to mean something.
EVIDENCE_SIGNING_SECRET=

# --- Admin ---
# Comma-separated emails allowed into /admin. Unset means nobody is an admin.
# An address here becomes an admin once someone signs up with it at /signup;
# there is no separate admin account type and no shared admin password.
ADMIN_EMAILS=
